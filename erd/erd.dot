digraph ERD {
  rankdir=LR; nodesep=0.6; ranksep=1.0;
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, arrowhead=crow, arrowtail=tee, dir=both, color="#555555"];

  students [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#2b6cb0" COLSPAN="2"><FONT COLOR="white"><B>students</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">student_id INTEGER</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">first_name VARCHAR(50)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">last_name VARCHAR(50)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">birth_date DATE</TD></TR>
    <TR><TD>UQ</TD><TD ALIGN="LEFT">email VARCHAR(100)</TD></TR>
  </TABLE>>];

  enrollments [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#2f855a" COLSPAN="2"><FONT COLOR="white"><B>enrollments</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">enrollment_id INTEGER</TD></TR>
    <TR><TD ALIGN="LEFT">FK, UQ1</TD><TD ALIGN="LEFT">student_id INTEGER</TD></TR>
    <TR><TD ALIGN="LEFT">FK, UQ1</TD><TD ALIGN="LEFT">course_id INTEGER</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">start_date DATE</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">rating SMALLINT NULL (1..100)</TD></TR>
  </TABLE>>];

  courses [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#c05621" COLSPAN="2"><FONT COLOR="white"><B>courses</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">course_id INTEGER</TD></TR>
    <TR><TD>UQ</TD><TD ALIGN="LEFT">code VARCHAR(10)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">title VARCHAR(120)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">price NUMERIC(10,2)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">duration_weeks SMALLINT</TD></TR>
    <TR><TD>FK</TD><TD ALIGN="LEFT">category_id INTEGER</TD></TR>
    <TR><TD>FK</TD><TD ALIGN="LEFT">teacher_id INTEGER</TD></TR>
  </TABLE>>];

  categories [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#6b46c1" COLSPAN="2"><FONT COLOR="white"><B>categories</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">category_id INTEGER</TD></TR>
    <TR><TD>UQ</TD><TD ALIGN="LEFT">name VARCHAR(80)</TD></TR>
  </TABLE>>];

  teachers [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#b83280" COLSPAN="2"><FONT COLOR="white"><B>teachers</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">teacher_id INTEGER</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">first_name VARCHAR(50)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">last_name VARCHAR(50)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">experience_years SMALLINT</TD></TR>
  </TABLE>>];

  students   -> enrollments [taillabel="1", headlabel="0..N"];
  courses    -> enrollments [taillabel="1", headlabel="0..N"];
  categories -> courses     [taillabel="1", headlabel="1..N"];
  teachers   -> courses     [taillabel="1", headlabel="0..N"];
}
